# Backend environment template for ArsipKu
# Copy this file to .env and fill the actual values.

NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=arsipku
DATABASE_USER=root
DATABASE_PASSWORD=your_database_password

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=7d

# Firebase Admin
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# AWS S3 / Storage
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name

# Search / Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# Optional
LOG_LEVEL=debug

# Add any additional values required by your NestJS config service.

# Mail Service (external email API)
MAIL_API_BASE_URL=https://send.airnavindonesia.co.id
MAIL_API_TOKEN=your_mail_api_token_here
