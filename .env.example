# Backend environment template for ArsipKu
# Copy this file to .env and fill the actual values.

NODE_ENV=development
PORT=3011

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=arsipku
DATABASE_USER=root
DATABASE_PASSWORD=your_database_password

# Archive Database (arsipku_arsip_local)
# Koneksi terpisah untuk backup arsip inaktif / musnah / permanen
ARCHIVE_DATABASE_HOST=localhost
ARCHIVE_DATABASE_PORT=3306
ARCHIVE_DATABASE_NAME=arsipku_arsip_local
ARCHIVE_DATABASE_USER=root
ARCHIVE_DATABASE_PASSWORD=your_database_password

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=7d

# AirNav Auth v2 — OAuth 2.0/OIDC Authorization Code + PKCE
# AUTH_REDIRECT_URI harus exact-match dengan URI yang didaftarkan untuk client.
AUTH_BASE_URL=https://auth.airnavindonesia.co.id/v2
AUTH_CLIENT_ID=your_registered_client_id
AUTH_CLIENT_SECRET=your_server_only_client_secret
AUTH_SCOPE=openid profile email
AUTH_REDIRECT_URI=http://localhost:3000/autharsipku
# Tujuan redirect browser sesudah callback (satu URL).
AUTH_FRONTEND_URL=http://localhost:3000
# Origin CORS boleh dipisahkan dengan koma.
FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_NAME=arsipku_sid
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_TTL_SECONDS=28800
REDIS_KEY_PREFIX=arsipku:auth:v2:

# Firebase Admin
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# AWS S3 / Storage
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name

# Search / Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# BSrE Configuration (API v2) — mode legacy (bsre_direct), dipakai untuk verify & fallback
BSRE_SIGNIN_URL=
BSRE_VERIFY_URL=
BSRE_TIMEOUT=30000
BSRE_BASIC_USER=
BSRE_BASIC_PASS=your_bsre_basic_password

# ── Portal TTE (client integration) ──
# Dev: http://localhost:3026/api/v1 | Prod: https://tte.airnavindonesia.co.id/admin/api/v1
TTE_BASE_URL=
# API Key (Opsi A — Bearer) ATAU Client ID/Secret (Opsi B) — minta provisioning ke admin Portal TTE
TTE_API_KEY=
TTE_CLIENT_ID=
TTE_CLIENT_SECRET=
# Redirect URL callback FE — wajib exact-match dengan allowlist admin portal
TTE_REDIRECT_URL=
# Webhook secret (opsional)
TTE_WEBHOOK_SECRET=
# DEV untuk development, PRD untuk production
TTE_DIGSIG_MODE=DEV
# Batas ukuran PDF yang diterima adapter Arsipku (default Portal: 20 MB)
TTE_MAX_FILE_SIZE_BYTES=20971520

# Optional
LOG_LEVEL=debug

# Add any additional values required by your NestJS config service.

# Mail Service (external email API)
MAIL_API_BASE_URL=https://send......
MAIL_API_TOKEN=your_mail_api_token_here

# WebSocket (Notification realtime)
WS_CORS_ORIGIN=http://localhost:3001
NOTIFICATION_WS_ENABLED=true

# Redis adapter (wajib jika backend multi instance / load balancer)
# Also used by @nestjs/cache-manager (master-data cache, key prefix arsipku:).
REDIS_URL=redis://username:password@host:port

# OnlyOffice Document Server (Naskah Lainnya feature)
# Kill switch: set ONLYOFFICE_ENABLED=true utk aktifkan fitur OnlyOffice editor + docx->pdf conversion.

# ─── Sentry (error monitoring) ────────────────────────────────────────────
# Sentry HANYA aktif jika SENTRY_DSN di-set. Jika kosong, Sentry no-op (aman).
# Dapatkan DSN dari https://sentry.io → project settings → Client Keys (DSN).
SENTRY_DSN=
# Sample rate untuk performance tracing (0.0 - 1.0). Default: 1.0 (100%).
SENTRY_TRACES_SAMPLE_RATE=1.0
# Sample rate untuk profiling (0.0 - 1.0). Default: 1.0 (100%).
SENTRY_PROFILES_SAMPLE_RATE=1.0
# Organization slug Sentry (untuk membangun link ke halaman event/issue).
# Dapatkan dari https://sentry.io/settings/ → Organization slug.
# Jika kosong, tombol "Lihat Detail di Sentry" tidak ditampilkan di frontend.
SENTRY_ORG=
# Project slug Sentry (untuk fallback URL ke halaman issues project).
SENTRY_PROJECT_SLUG=
# Default false = fitur off, BE boot tanpa OnlyOffice Docker. Set true + isi URL/SECRET pas Docker siap.
ONLYOFFICE_ENABLED=false

# Configurable DI/SDI correspondence routing overlay. Keep false until UAT/sign-off.
CORRESPONDENCE_ROUTING_ENABLED=false
ONLYOFFICE_URL=http://localhost:80
ONLYOFFICE_JWT_SECRET=your_onlyoffice_jwt_secret
APP_PUBLIC_URL=http://host.docker.internal:3011

# Database Audit Trail (MongoDB) server
MONGODB_URI=
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=
GOTENBERG_TIMEOUT_MS=60000
